# Supabase backend
# Copy this file to .env and fill in your project values.
# Without these values the app runs in local demo mode (password: evolve).
#
# URL: Project Settings > API > Project URL
# Key: the publishable key (sb_publishable_...) or the legacy anon public key —
# both are safe for the browser and are used together with Supabase Auth.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key
